# Copy this file to .env and enter the connection URL from your DBeaver connection.
# Keep the actual .env private; never put this URL in frontend code or share it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require
PORT=3001
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
